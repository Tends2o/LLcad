[Unit]
Description=LLcad local CAD server (MCP over HTTP and browser viewer on loopback)
After=network.target

[Service]
Type=simple
# Adjust the paths to your checkout, Node installation and data directory.
WorkingDirectory=/opt/llcad
ExecStart=/usr/bin/node /opt/llcad/dist/packages/mcp-gateway/main.js
Environment=MATHFORGE_ROOT=/opt/llcad
Environment=MATHFORGE_DATA=/opt/llcad/data
Environment=MATHFORGE_AUTH=local
Environment=HOST=127.0.0.1
Environment=PORT=4310
Environment=MATHFORGE_PUBLIC_URL=http://127.0.0.1:4310
Restart=on-failure
RestartSec=3
TimeoutStopSec=55
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/llcad/data
# RestrictSUIDSGID's syscall filter blocks this Bubblewrap's mount setup.
# NoNewPrivileges remains enabled; workers drop all capabilities and UID/GID.
LockPersonality=true
LimitNOFILE=4096
MemoryMax=2G
TasksMax=128

[Install]
WantedBy=multi-user.target
