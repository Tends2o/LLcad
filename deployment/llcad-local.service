[Unit]
Description=LLcad local CAD tools for LLM clients
After=network.target

[Service]
Type=simple
WorkingDirectory=/root/projekte/LLcad
ExecStart=/root/.nvm/versions/node/v24.19.0/bin/node /root/projekte/LLcad/dist/packages/mcp-gateway/main.js
Environment=PATH=/root/.nvm/versions/node/v24.19.0/bin:/usr/local/bin:/usr/bin:/bin
Environment=MATHFORGE_ROOT=/root/projekte/LLcad
Environment=MATHFORGE_DATA=/root/projekte/LLcad/data
Environment=MATHFORGE_AUTH=local
Environment=HOST=127.0.0.1
Environment=PORT=4310
Environment=MATHFORGE_PUBLIC_URL=http://127.0.0.1:4310
Restart=on-failure
RestartSec=3
TimeoutStopSec=55
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/root/projekte/LLcad/data
# RestrictSUIDSGID's syscall filter blocks this Bubblewrap's mount setup.
# NoNewPrivileges remains enabled; workers drop all capabilities and UID/GID.
LockPersonality=true
LimitNOFILE=4096
MemoryMax=2G
TasksMax=128

[Install]
WantedBy=multi-user.target
