{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^mcp__llcad__cad_.*$",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 /opt/llcad/hooks/optional-host/client_preflight.py",
            "timeout": 3
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^mcp__llcad__cad_.*$",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 /opt/llcad/hooks/optional-host/client_summary.py",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
