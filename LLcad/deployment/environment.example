# Additional server options. install.ps1 writes the local configuration to ..\llcad.env
# (stdio bridge, local token, loopback only); the bridge passes it to the server.
# The values below show a shared HTTP endpoint with OAuth instead of the local token.
HOST=127.0.0.1
PORT=4310
MATHFORGE_ROOT=C:\llcad\LLcad\LLcad
MATHFORGE_DATA=C:\llcad\LLcad\LLcad\data
MATHFORGE_AUTH=oauth
# Replace these values with your actual HTTPS resource and identity provider.
MATHFORGE_PUBLIC_URL=https://cad.example.invalid
MATHFORGE_AUDIENCE=https://cad.example.invalid/mcp
MATHFORGE_ISSUER=https://identity.example.invalid
MATHFORGE_JWKS_URL=https://identity.example.invalid/.well-known/jwks.json
# Folders that patch_ref files and SVG logos may be read from (semicolon-separated).
# LLCAD_PATCH_PATHS=C:\llcad;C:\llcad\LLcad\LLcad\data\uploads
# Idle exit after N minutes without requests (0 or unset = run until stopped).
# LLCAD_IDLE_EXIT_MINUTES=15
