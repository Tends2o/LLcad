{
  "name": "mathforge-3d",
  "version": "0.1.0",
  "description": "Mathematics-first CAD server for MCP clients: versioned constructions, real Open CASCADE geometry, validated commits and an optional browser viewer.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "cad",
    "occt",
    "opencascade",
    "3d",
    "geometry",
    "brep",
    "step",
    "parametric"
  ],
  "homepage": "https://github.com/Tends2o/LLcad#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tends2o/LLcad.git"
  },
  "bugs": {
    "url": "https://github.com/Tends2o/LLcad/issues"
  },
  "license": "GPL-3.0-or-later",
  "private": true,
  "type": "module",
  "bin": {
    "llcad-mcp": "bin/llcad-mcp.mjs",
    "llcad-server": "bin/llcad-server.mjs"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx packages/mcp-gateway/main.ts",
    "start": "node dist/packages/mcp-gateway/main.js",
    "mcp": "node dist/packages/mcp-gateway/stdio.js",
    "build": "python3 scripts/build-native.py && tsc && esbuild packages/viewer/app.ts --bundle --format=esm --minify --outfile=public/app.js",
    "typecheck": "tsc --noEmit",
    "schemas": "tsx scripts/schemas.ts",
    "format": "prettier --write packages hooks scripts public/index.html public/style.css",
    "format:check": "prettier --check packages hooks scripts public/index.html public/style.css",
    "setup": "bash deployment/setup.sh",
    "build:native": "python3 scripts/build-native.py"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "decimal.js": "10.6.0",
    "express": "5.2.1",
    "jose": "6.2.12",
    "three": "0.186.0",
    "zod": "4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/express": "5.0.6",
    "@types/node": "26.5.1",
    "@types/three": "0.186.0",
    "esbuild": "0.28.2",
    "fast-check": "4.10.0",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  }
}
