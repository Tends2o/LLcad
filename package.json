{
  "name": "mathforge-3d",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx packages/mcp-gateway/main.ts",
    "start": "node dist/packages/mcp-gateway/main.js",
    "mcp": "node dist/packages/mcp-gateway/stdio.js",
    "build": "python3 scripts/build-native.py && tsc && esbuild packages/viewer/app.ts --bundle --format=esm --minify --outfile=public/app.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 tests/**/*.test.ts",
    "test:geometry": ".venv/bin/python -m unittest discover -s tests/geometry -v",
    "test:browser": "tsx scripts/browser-test.ts",
    "test:mcp": "tsx scripts/mcp-workflow.ts",
    "test:host": "tsx scripts/codex-host.ts",
    "test:llm": "tsx scripts/llm-eval.ts",
    "schemas": "tsx scripts/schemas.ts",
    "demo": "tsx scripts/demo.ts",
    "benchmark": "tsx benchmarks/run.ts",
    "release:check": "tsx scripts/release.ts",
    "plan:check": "tsx scripts/plan-audit.ts",
    "versions:check": "tsx scripts/versions.ts",
    "licenses": "tsx scripts/licenses.ts",
    "verify": "python3 scripts/build-native.py && tsx scripts/verify.ts",
    "format": "prettier --write packages hooks scripts tests benchmarks public/index.html public/style.css",
    "format:check": "prettier --check packages hooks scripts tests benchmarks public/index.html public/style.css",
    "setup": "bash deployment/setup.sh",
    "build:native": "python3 scripts/build-native.py"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "decimal.js": "10.6.0",
    "express": "5.2.1",
    "jose": "6.2.12",
    "three": "0.186.0",
    "zod": "4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/express": "5.0.6",
    "@types/node": "26.5.1",
    "@types/three": "0.186.0",
    "esbuild": "0.28.2",
    "fast-check": "4.10.0",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  }
}
