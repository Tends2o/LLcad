  "$defs": {
    "__schema0": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$"
    },
    "__schema1": {
      "pattern": "^[a-f0-9]{64}$",
      "$ref": "#/$defs/__schema2"
    },
    "__schema2": {
      "type": "string"
    },
    "__schema3": {
      "type": "string",
      "enum": [
        "precision_cad",
        "render_surface"
      ]
    },
    "__schema4": {
      "type": "string",
      "enum": [
        "failed",
        "checks_passed_within_profile"
      ]
    },
    "__schema5": {
      "type": "object",
      "properties": {
        "check_id": {
          "$ref": "#/$defs/__schema2"
        },
        "target": {
          "$ref": "#/$defs/__schema2"
        },
        "method": {
          "$ref": "#/$defs/__schema2"
        },
        "guarantee": {
          "$ref": "#/$defs/__schema6"
        },
        "coverage": {
          "$ref": "#/$defs/__schema2"
        },
        "status": {
          "$ref": "#/$defs/__schema7"
        },
        "measured": {
          "$ref": "#/$defs/__schema8"
        },
        "requested": {
          "$ref": "#/$defs/__schema8"
        },
        "error_bound": {
          "$ref": "#/$defs/__schema9"
        }
      },
      "required": [
        "check_id",
        "target",
        "method",
        "guarantee",
        "coverage",
        "status",
        "measured",
        "error_bound"
      ],
      "additionalProperties": false
    },
    "__schema6": {
      "type": "string",
      "enum": [
        "sampled",
        "bounded",
        "exact_for_declared_domain",
        "reported_kernel_tolerances_not_a_global_surface_error_certificate"
      ]
    },
    "__schema7": {
      "type": "string",
      "enum": [
        "passed",
        "failed"
      ]
    },
    "__schema8": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema8"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema8"
          }
        }
      ]
    },
    "__schema9": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "__schema10": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema2"
      }
    },
    "__schema11": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "__schema12": {
      "type": "object",
      "properties": {
        "check_id": {
          "$ref": "#/$defs/__schema2"
        },
        "target": {
          "$ref": "#/$defs/__schema2"
        },
        "method": {
          "$ref": "#/$defs/__schema2"
        },
        "guarantee": {
          "$ref": "#/$defs/__schema6"
        },
        "coverage": {
          "$ref": "#/$defs/__schema2"
        },
        "status": {
          "$ref": "#/$defs/__schema7"
        },
        "measured": {
          "$ref": "#/$defs/__schema8"
        },
        "requested": {
          "$ref": "#/$defs/__schema8"
        },
        "error_bound": {
          "$ref": "#/$defs/__schema9"
        },
        "revision": {
          "$ref": "#/$defs/__schema0"
        },
        "engine_build": {
          "$ref": "#/$defs/__schema2"
        },
        "source_geometry_hash": {
          "$ref": "#/$defs/__schema1"
        }
      },
      "required": [
        "check_id",
        "target",
        "method",
        "guarantee",
        "coverage",
        "status",
        "measured",
        "requested",
        "error_bound",
        "revision",
        "engine_build",
        "source_geometry_hash"
      ],
      "additionalProperties": false
    }
  }
