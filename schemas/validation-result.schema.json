          "$ref": "#/$defs/__schema0"
        },
        "ir_hash": {
          "$ref": "#/$defs/__schema1"
        },
        "geometry_digest": {
          "$ref": "#/$defs/__schema1"
        },
        "registry_hash": {
          "$ref": "#/$defs/__schema1"
        },
        "policy_hash": {
          "$ref": "#/$defs/__schema1"
        },
        "engine_build": {
          "$ref": "#/$defs/__schema2"
        },
        "profile": {
          "$ref": "#/$defs/__schema3"
        },
        "status": {
          "$ref": "#/$defs/__schema4"
        },
        "digest": {
          "$ref": "#/$defs/__schema1"
        },
        "checks": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema5"
          }
        },
        "warnings": {
          "$ref": "#/$defs/__schema10"
        },
        "created_at": {
          "$ref": "#/$defs/__schema11"
        }
      },
      "required": [
        "candidate_revision",
        "ir_hash",
        "geometry_digest",
        "registry_hash",
        "policy_hash",
        "engine_build",
        "profile",
        "status",
        "digest",
        "checks",
        "warnings",
        "created_at"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "candidate_revision": {
          "$ref": "#/$defs/__schema0"
        },
        "ir_hash": {
          "$ref": "#/$defs/__schema1"
        },
        "geometry_digest": {
          "$ref": "#/$defs/__schema1"
        },
        "registry_hash": {
          "$ref": "#/$defs/__schema1"
        },
        "policy_hash": {
          "$ref": "#/$defs/__schema1"
        },
        "engine_build": {
          "$ref": "#/$defs/__schema2"
        },
        "profile": {
          "$ref": "#/$defs/__schema3"
        },
        "status": {
          "$ref": "#/$defs/__schema4"
        },
        "digest": {
          "$ref": "#/$defs/__schema1"
        },
        "checks": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema12"
          }
        },
        "warnings": {
          "$ref": "#/$defs/__schema10"
        },
        "created_at": {
          "$ref": "#/$defs/__schema11"
        },
        "schema_version": {
          "type": "string",
          "const": "2"
        }
      },
      "required": [
        "candidate_revision",
        "ir_hash",
        "geometry_digest",
        "registry_hash",
        "policy_hash",
        "engine_build",
        "profile",
        "status",
        "digest",
        "checks",
        "warnings",
        "created_at",
        "schema_version"
      ],
      "additionalProperties": false
    }
