{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "result_schema_version": {
      "type": "string",
      "const": "1"
    },
    "status": {
      "type": "string",
      "const": "failed"
    },
    "trace_id": {
      "$ref": "#/$defs/__schema0"
    },
    "model_id": {
      "type": "null"
    },
    "revision": {
      "type": "null"
    },
    "candidate_revision": {
      "type": "null"
    },
    "transaction_id": {
      "type": "null"
    },
    "job_id": {
      "type": "null"
    },
    "measurements": {
      "type": "null"
    },
    "checks": {
      "type": "array",
      "items": false,
      "maxItems": 0
    },
    "warnings": {
      "$ref": "#/$defs/__schema1"
    },
    "errors": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema3"
      }
    },
    "assumptions": {
      "$ref": "#/$defs/__schema1"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "artifact_id": {
            "$ref": "#/$defs/__schema0"
          },
          "uri": {
            "pattern": "^cad:\\/\\/artifacts\\/[a-zA-Z0-9_-]+\\/manifest$",
            "$ref": "#/$defs/__schema2"
          },
          "download": {
            "pattern": "^\\/api\\/artifacts\\/[a-zA-Z0-9_-]+$",
            "$ref": "#/$defs/__schema2"
          },
          "hash": {
            "pattern": "^[a-f0-9]{64}$",
            "$ref": "#/$defs/__schema2"
          },
          "mime": {
            "$ref": "#/$defs/__schema2"
          },
          "size": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "manifest": {
            "$ref": "#/$defs/__schema4"
          }
        },
        "required": [
          "artifact_id",
          "uri",
          "download",
          "hash",
          "mime",
          "size",
          "manifest"
        ],
        "additionalProperties": false
      }
    },
    "recommended_next_actions": {
      "$ref": "#/$defs/__schema1"
    },
    "committed": {
      "type": "boolean",
      "const": false
    }
  },
  "required": [
    "result_schema_version",
    "status",
    "trace_id",
    "model_id",
    "revision",
    "candidate_revision",
    "transaction_id",
    "job_id",
    "measurements",
    "checks",
    "warnings",
    "errors",
    "assumptions",
    "artifacts",
    "recommended_next_actions",
    "committed"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$"
    },
    "__schema1": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema2"
      }
    },
    "__schema2": {
      "type": "string"
    },
    "__schema3": {
      "type": "object",
      "properties": {
        "code": {
          "minLength": 1,
          "$ref": "#/$defs/__schema2"
        },
        "message": {
          "$ref": "#/$defs/__schema2"
        },
        "details": {
          "$ref": "#/$defs/__schema4"
        }
      },
      "required": [
        "code",
        "message",
        "details"
      ],
      "additionalProperties": false
    },
    "__schema4": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/__schema2"
      },
      "additionalProperties": {
        "$ref": "#/$defs/__schema5"
      }
    },
    "__schema5": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema5"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema5"
          }
        }
      ]
    }
  }
}
