{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "result_schema_version": {
          "$ref": "#/$defs/__schema0"
        },
        "status": {
          "type": "string",
          "const": "committed"
        },
        "trace_id": {
          "$ref": "#/$defs/__schema1"
        },
        "model_id": {
          "$ref": "#/$defs/__schema1"
        },
        "revision": {
          "$ref": "#/$defs/__schema1"
        },
        "candidate_revision": {
          "$ref": "#/$defs/__schema2"
        },
        "transaction_id": {
          "$ref": "#/$defs/__schema1"
        },
        "job_id": {
          "$ref": "#/$defs/__schema3"
        },
        "measurements": {
          "$ref": "#/$defs/__schema4"
        },
        "checks": {
          "$ref": "#/$defs/__schema5"
        },
        "warnings": {
          "$ref": "#/$defs/__schema6"
        },
        "errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema8"
          }
        },
        "assumptions": {
          "$ref": "#/$defs/__schema6"
        },
        "artifacts": {
          "$ref": "#/$defs/__schema11"
        },
        "recommended_next_actions": {
          "$ref": "#/$defs/__schema6"
        },
        "validation_digest": {
          "$ref": "#/$defs/__schema12"
        },
        "committed": {
          "type": "boolean",
          "const": true
        },
        "quality": {
          "type": "string",
          "const": "checks_passed_within_profile"
        }
      },
      "required": [
        "result_schema_version",
        "status",
        "trace_id",
        "model_id",
        "revision",
        "candidate_revision",
        "transaction_id",
        "job_id",
        "measurements",
        "checks",
        "warnings",
        "errors",
        "assumptions",
        "artifacts",
        "recommended_next_actions",
        "validation_digest",
        "committed",
        "quality"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "result_schema_version": {
          "$ref": "#/$defs/__schema0"
        },
        "status": {
          "type": "string",
          "const": "failed"
        },
        "trace_id": {
          "$ref": "#/$defs/__schema1"
        },
        "model_id": {
          "type": "null"
        },
        "revision": {
          "type": "null"
        },
        "candidate_revision": {
          "$ref": "#/$defs/__schema2"
        },
        "transaction_id": {
          "type": "null"
        },
        "job_id": {
          "$ref": "#/$defs/__schema3"
        },
        "measurements": {
          "$ref": "#/$defs/__schema4"
        },
        "checks": {
          "$ref": "#/$defs/__schema5"
        },
        "warnings": {
          "$ref": "#/$defs/__schema6"
        },
        "errors": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema8"
          }
        },
        "assumptions": {
          "$ref": "#/$defs/__schema6"
        },
        "artifacts": {
          "$ref": "#/$defs/__schema11"
        },
        "recommended_next_actions": {
          "$ref": "#/$defs/__schema6"
        },
        "committed": {
          "type": "boolean",
          "const": false
        }
      },
      "required": [
        "result_schema_version",
        "status",
        "trace_id",
        "model_id",
        "revision",
        "candidate_revision",
        "transaction_id",
        "job_id",
        "measurements",
        "checks",
        "warnings",
        "errors",
        "assumptions",
        "artifacts",
        "recommended_next_actions",
        "committed"
      ],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "__schema0": {
      "type": "string",
      "const": "1"
    },
    "__schema1": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$"
    },
    "__schema2": {
      "type": "null"
    },
    "__schema3": {
      "type": "null"
    },
    "__schema4": {
      "type": "null"
    },
    "__schema5": {
      "type": "array",
      "items": false,
      "maxItems": 0
    },
    "__schema6": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema7"
      }
    },
    "__schema7": {
      "type": "string"
    },
    "__schema8": {
      "type": "object",
      "properties": {
        "code": {
          "minLength": 1,
          "$ref": "#/$defs/__schema7"
        },
        "message": {
          "$ref": "#/$defs/__schema7"
        },
        "details": {
          "$ref": "#/$defs/__schema9"
        }
      },
      "required": [
        "code",
        "message",
        "details"
      ],
      "additionalProperties": false
    },
    "__schema9": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/__schema7"
      },
      "additionalProperties": {
        "$ref": "#/$defs/__schema10"
      }
    },
    "__schema10": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema10"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema10"
          }
        }
      ]
    },
    "__schema11": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "artifact_id": {
            "$ref": "#/$defs/__schema1"
          },
          "uri": {
            "pattern": "^cad:\\/\\/artifacts\\/[a-zA-Z0-9_-]+\\/manifest$",
            "$ref": "#/$defs/__schema7"
          },
          "download": {
            "pattern": "^\\/api\\/artifacts\\/[a-zA-Z0-9_-]+$",
            "$ref": "#/$defs/__schema7"
          },
          "hash": {
            "$ref": "#/$defs/__schema12"
          },
          "mime": {
            "$ref": "#/$defs/__schema7"
          },
          "size": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "manifest": {
            "$ref": "#/$defs/__schema9"
          }
        },
        "required": [
          "artifact_id",
          "uri",
          "download",
          "hash",
          "mime",
          "size",
          "manifest"
        ],
        "additionalProperties": false
      }
    },
    "__schema12": {
      "pattern": "^[a-f0-9]{64}$",
      "$ref": "#/$defs/__schema7"
    }
  },
  "type": "object"
}
