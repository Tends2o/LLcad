{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "model_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$"
    },
    "base_revision": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 16,
      "maxLength": 128
    },
    "problem": {
      "type": "object",
      "properties": {
        "variables": {
          "minItems": 1,
          "maxItems": 12,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "feature_id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$"
              },
              "parameter": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,63}$"
              },
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,63}$"
              },
              "expected": {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "string",
                    "maxLength": 48,
                    "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
                  },
                  "unit": {
                    "type": "string",
                    "enum": [
                      "1",
                      "m",
                      "mm",
                      "um",
                      "rad",
                      "deg"
                    ]
                  }
                },
                "required": [
                  "value",
                  "unit"
                ],
                "additionalProperties": false
              },
              "lower": {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "string",
                    "maxLength": 48,
                    "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
                  },
                  "unit": {
                    "type": "string",
                    "enum": [
                      "1",
                      "m",
                      "mm",
                      "um",
                      "rad",
                      "deg"
                    ]
                  }
                },
                "required": [
                  "value",
                  "unit"
                ],
                "additionalProperties": false
              },
              "upper": {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "string",
                    "maxLength": 48,
                    "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
                  },
                  "unit": {
                    "type": "string",
                    "enum": [
                      "1",
                      "m",
                      "mm",
                      "um",
                      "rad",
                      "deg"
                    ]
                  }
                },
                "required": [
                  "value",
                  "unit"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "feature_id",
              "parameter",
              "name",
              "expected",
              "lower",
              "upper"
            ],
            "additionalProperties": false
          }
        },
        "equations": {
          "minItems": 1,
          "maxItems": 32,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$"
              },
              "expression": {
                "$ref": "#/$defs/__schema0"
              },
              "relation": {
                "type": "string",
                "enum": [
                  "eq",
                  "ge",
                  "le"
                ]
              },
              "tolerance": {
                "type": "string",
                "maxLength": 48,
                "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
              }
            },
            "required": [
              "id",
              "expression",
              "relation",
              "tolerance"
            ],
            "additionalProperties": false
          }
        },
        "objectives": {
          "default": [],
          "maxItems": 32,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$"
              },
              "expression": {
                "$ref": "#/$defs/__schema0"
              },
              "weight": {
                "default": "1",
                "type": "string",
                "maxLength": 48,
                "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
              },
              "scale": {
                "default": "1",
                "type": "string",
                "maxLength": 48,
                "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
              },
              "loss": {
                "default": "none",
                "type": "string",
                "enum": [
                  "none",
                  "huber",
                  "cauchy"
                ]
              }
            },
            "required": [
              "id",
              "expression",
              "weight",
              "scale",
              "loss"
            ],
            "additionalProperties": false
          }
        },
        "regularization": {
          "default": "1",
          "type": "string",
          "maxLength": 48,
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
        },
        "max_iterations": {
          "default": 100,
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        }
      },
      "required": [
        "variables",
        "equations",
        "objectives",
        "regularization",
        "max_iterations"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "model_id",
    "base_revision",
    "idempotency_key",
    "problem"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "constant": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "string",
                  "maxLength": 48,
                  "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
                },
                "unit": {
                  "type": "string",
                  "enum": [
                    "1",
                    "m",
                    "mm",
                    "um",
                    "rad",
                    "deg"
                  ]
                }
              },
              "required": [
                "value",
                "unit"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "constant"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "parameter": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,63}$"
            }
          },
          "required": [
            "parameter"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "fn": {
              "type": "string",
              "enum": [
                "+",
                "-",
                "*",
                "/",
                "sqrt",
                "sin",
                "cos",
                "atan2",
                "min",
                "max",
                "abs",
                "clamp",
                "vec3",
                "dot",
                "norm"
              ]
            },
            "args": {
              "minItems": 1,
              "maxItems": 3,
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema0"
              }
            }
          },
          "required": [
            "fn",
            "args"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
