{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "result_schema_version": {
          "$ref": "#/$defs/__schema0"
        },
        "status": {
          "type": "string",
          "const": "queued"
        },
        "trace_id": {
          "$ref": "#/$defs/__schema1"
        },
        "model_id": {
          "$ref": "#/$defs/__schema1"
        },
        "revision": {
          "$ref": "#/$defs/__schema2"
        },
        "candidate_revision": {
          "$ref": "#/$defs/__schema1"
        },
        "transaction_id": {
          "$ref": "#/$defs/__schema1"
        },
        "job_id": {
          "$ref": "#/$defs/__schema1"
        },
        "measurements": {
          "$ref": "#/$defs/__schema3"
        },
        "checks": {
          "$ref": "#/$defs/__schema4"
        },
        "warnings": {
          "$ref": "#/$defs/__schema5"
        },
        "errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema7"
          }
        },
        "assumptions": {
          "$ref": "#/$defs/__schema5"
        },
        "artifacts": {
          "$ref": "#/$defs/__schema10"
        },
        "recommended_next_actions": {
          "$ref": "#/$defs/__schema5"
        },
        "committed": {
          "type": "boolean",
          "const": false
        },
        "base_revision": {
          "$ref": "#/$defs/__schema1"
        },
        "repair_attempt": {
          "type": "object",
          "properties": {
            "attempt": {
              "$ref": "#/$defs/__schema11"
            },
            "of_transaction": {
              "$ref": "#/$defs/__schema1"
            },
            "cause": {
              "$ref": "#/$defs/__schema6"
            },
            "remaining": {
              "$ref": "#/$defs/__schema11"
            },
            "intent_comparison": {
              "type": "object",
              "properties": {
                "original_changed_features": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/__schema1"
                  }
                },
                "this_changed_features": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/__schema1"
                  }
                },
                "same_targets": {
                  "type": "boolean"
                }
              },
              "required": [
                "original_changed_features",
                "this_changed_features",
                "same_targets"
              ],
              "additionalProperties": false
            },
            "previous_attempts": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "transaction_id": {
                    "$ref": "#/$defs/__schema1"
                  },
                  "cause": {
                    "anyOf": [
                      {
                        "$ref": "#/$defs/__schema6"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "state": {
                    "$ref": "#/$defs/__schema6"
                  },
                  "cost_seconds": {
                    "anyOf": [
                      {
                        "type": "number",
                        "minimum": 0
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "transaction_id",
                  "cause",
                  "state",
                  "cost_seconds"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "attempt",
            "of_transaction",
            "cause",
            "remaining",
            "intent_comparison",
            "previous_attempts"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "result_schema_version",
        "status",
        "trace_id",
        "model_id",
        "revision",
        "candidate_revision",
        "transaction_id",
        "job_id",
        "measurements",
        "checks",
        "warnings",
        "errors",
        "assumptions",
        "artifacts",
        "recommended_next_actions",
        "committed",
        "base_revision"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "result_schema_version": {
          "$ref": "#/$defs/__schema0"
        },
        "status": {
          "type": "string",
          "const": "failed"
        },
        "trace_id": {
          "$ref": "#/$defs/__schema1"
        },
        "model_id": {
          "type": "null"
        },
        "revision": {
          "$ref": "#/$defs/__schema2"
        },
        "candidate_revision": {
          "type": "null"
        },
        "transaction_id": {
          "type": "null"
        },
        "job_id": {
          "type": "null"
        },
        "measurements": {
          "$ref": "#/$defs/__schema3"
        },
        "checks": {
          "$ref": "#/$defs/__schema4"
        },
        "warnings": {
          "$ref": "#/$defs/__schema5"
        },
        "errors": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema7"
          }
        },
        "assumptions": {
          "$ref": "#/$defs/__schema5"
        },
        "artifacts": {
          "$ref": "#/$defs/__schema10"
        },
        "recommended_next_actions": {
          "$ref": "#/$defs/__schema5"
        },
        "committed": {
          "type": "boolean",
          "const": false
        }
      },
      "required": [
        "result_schema_version",
        "status",
        "trace_id",
        "model_id",
        "revision",
        "candidate_revision",
        "transaction_id",
        "job_id",
        "measurements",
        "checks",
        "warnings",
        "errors",
        "assumptions",
        "artifacts",
        "recommended_next_actions",
        "committed"
      ],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "__schema0": {
      "type": "string",
      "const": "1"
    },
    "__schema1": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$"
    },
    "__schema2": {
      "type": "null"
    },
    "__schema3": {
      "type": "null"
    },
    "__schema4": {
      "type": "array",
      "items": false,
      "maxItems": 0
    },
    "__schema5": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema6"
      }
    },
    "__schema6": {
      "type": "string"
    },
    "__schema7": {
      "type": "object",
      "properties": {
        "code": {
          "minLength": 1,
          "$ref": "#/$defs/__schema6"
        },
        "message": {
          "$ref": "#/$defs/__schema6"
        },
        "details": {
          "$ref": "#/$defs/__schema8"
        }
      },
      "required": [
        "code",
        "message",
        "details"
      ],
      "additionalProperties": false
    },
    "__schema8": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/__schema6"
      },
      "additionalProperties": {
        "$ref": "#/$defs/__schema9"
      }
    },
    "__schema9": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema9"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema9"
          }
        }
      ]
    },
    "__schema10": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "artifact_id": {
            "$ref": "#/$defs/__schema1"
          },
          "uri": {
            "pattern": "^cad:\\/\\/artifacts\\/[a-zA-Z0-9_-]+\\/manifest$",
            "$ref": "#/$defs/__schema6"
          },
          "download": {
            "pattern": "^\\/api\\/artifacts\\/[a-zA-Z0-9_-]+$",
            "$ref": "#/$defs/__schema6"
          },
          "hash": {
            "pattern": "^[a-f0-9]{64}$",
            "$ref": "#/$defs/__schema6"
          },
          "mime": {
            "$ref": "#/$defs/__schema6"
          },
          "size": {
            "$ref": "#/$defs/__schema11"
          },
          "manifest": {
            "$ref": "#/$defs/__schema8"
          }
        },
        "required": [
          "artifact_id",
          "uri",
          "download",
          "hash",
          "mime",
          "size",
          "manifest"
        ],
        "additionalProperties": false
      }
    },
    "__schema11": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "type": "object"
}
