{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "result_schema_version": {
          "$ref": "#/$defs/__schema0"
        },
        "status": {
          "type": "string",
          "const": "ok"
        },
        "trace_id": {
          "$ref": "#/$defs/__schema1"
        },
        "model_id": {
          "$ref": "#/$defs/__schema1"
        },
        "revision": {
          "$ref": "#/$defs/__schema1"
        },
        "candidate_revision": {
          "$ref": "#/$defs/__schema2"
        },
        "transaction_id": {
          "$ref": "#/$defs/__schema3"
        },
        "job_id": {
          "$ref": "#/$defs/__schema4"
        },
        "measurements": {
          "anyOf": [
            {
              "description": "Registered engine facts, with finite JSON values. Native and implicit facts have different fields.",
              "$ref": "#/$defs/__schema7"
            },
            {
              "type": "null"
            }
          ]
        },
        "checks": {
          "$ref": "#/$defs/__schema8"
        },
        "warnings": {
          "$ref": "#/$defs/__schema9"
        },
        "errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema10"
          }
        },
        "assumptions": {
          "$ref": "#/$defs/__schema9"
        },
        "artifacts": {
          "$ref": "#/$defs/__schema11"
        },
        "recommended_next_actions": {
          "$ref": "#/$defs/__schema9"
        },
        "name": {
          "$ref": "#/$defs/__schema5"
        },
        "purpose": {
          "$ref": "#/$defs/__schema5"
        },
        "head_revision": {
          "$ref": "#/$defs/__schema1"
        },
        "unit": {
          "type": "string",
          "const": "mm"
        },
        "quality": {
          "type": "string",
          "enum": [
            "preview_only",
            "checks_passed_within_profile"
          ]
        },
        "build_compatibility": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "const": "current"
                },
                "target_registry_hash": {
                  "$ref": "#/$defs/__schema12"
                }
              },
              "required": [
                "status",
                "target_registry_hash"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "enum": [
                    "rebuild_required",
                    "unsupported_construction"
                  ]
                },
                "target_registry_hash": {
                  "$ref": "#/$defs/__schema12"
                },
                "diagnostic": {
                  "$ref": "#/$defs/__schema10"
                }
              },
              "required": [
                "status",
                "target_registry_hash",
                "diagnostic"
              ],
              "additionalProperties": false
            }
          ]
        },
        "feature_count": {
          "$ref": "#/$defs/__schema13"
        },
        "structure": {
          "type": "object",
          "properties": {
            "hash": {
              "$ref": "#/$defs/__schema12"
            },
            "stored_explicitly": {
              "type": "boolean"
            },
            "assemblies": {
              "$ref": "#/$defs/__schema13"
            },
            "parts": {
              "$ref": "#/$defs/__schema13"
            },
            "frames": {
              "$ref": "#/$defs/__schema13"
            }
          },
          "required": [
            "hash",
            "stored_explicitly",
            "assemblies",
            "parts",
            "frames"
          ],
          "additionalProperties": false
        },
        "features": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/$defs/__schema1"
              },
              "semantic_name": {
                "$ref": "#/$defs/__schema5"
              },
              "kind": {
                "$ref": "#/$defs/__schema5"
              },
              "operator": {
                "$ref": "#/$defs/__schema5"
              },
              "depends_on": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/__schema1"
                }
              },
              "owner_part": {
                "$ref": "#/$defs/__schema1"
              },
              "local_frame": {
                "$ref": "#/$defs/__schema1"
              },
              "representation": {
                "type": "string",
                "enum": [
                  "brep",
                  "implicit",
                  "mesh"
                ]
              },
              "parameters": {
                "type": "object",
                "propertyNames": {
                  "$ref": "#/$defs/__schema5"
                },
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "value": {
                      "$ref": "#/$defs/__schema5"
                    },
                    "unit": {
                      "$ref": "#/$defs/__schema5"
                    }
                  },
                  "required": [
                    "value",
                    "unit"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "id",
              "semantic_name",
              "kind",
              "operator",
              "depends_on",
              "owner_part",
              "local_frame",
              "representation",
              "parameters"
            ],
            "additionalProperties": false
          }
        },
        "next_offset": {
          "anyOf": [
            {
              "$ref": "#/$defs/__schema13"
            },
            {
              "type": "null"
            }
          ]
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema1"
          }
        }
      },
      "required": [
        "result_schema_version",
        "status",
        "trace_id",
        "model_id",
        "revision",
        "candidate_revision",
        "transaction_id",
        "job_id",
        "measurements",
        "checks",
        "warnings",
        "errors",
        "assumptions",
        "artifacts",
        "recommended_next_actions",
        "name",
        "purpose",
        "head_revision",
        "unit",
        "quality",
        "build_compatibility",
        "feature_count",
        "structure",
        "features",
        "next_offset",
        "outputs"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "result_schema_version": {
          "$ref": "#/$defs/__schema0"
        },
        "status": {
          "type": "string",
          "const": "failed"
        },
        "trace_id": {
          "$ref": "#/$defs/__schema1"
        },
        "model_id": {
          "type": "null"
        },
        "revision": {
          "type": "null"
        },
        "candidate_revision": {
          "$ref": "#/$defs/__schema2"
        },
        "transaction_id": {
          "$ref": "#/$defs/__schema3"
        },
        "job_id": {
          "$ref": "#/$defs/__schema4"
        },
        "measurements": {
          "type": "null"
        },
        "checks": {
          "$ref": "#/$defs/__schema8"
        },
        "warnings": {
          "$ref": "#/$defs/__schema9"
        },
        "errors": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema10"
          }
        },
        "assumptions": {
          "$ref": "#/$defs/__schema9"
        },
        "artifacts": {
          "$ref": "#/$defs/__schema11"
        },
        "recommended_next_actions": {
          "$ref": "#/$defs/__schema9"
        },
        "committed": {
          "type": "boolean",
          "const": false
        }
      },
      "required": [
        "result_schema_version",
        "status",
        "trace_id",
        "model_id",
        "revision",
        "candidate_revision",
        "transaction_id",
        "job_id",
        "measurements",
        "checks",
        "warnings",
        "errors",
        "assumptions",
        "artifacts",
        "recommended_next_actions",
        "committed"
      ],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "__schema0": {
      "type": "string",
      "const": "1"
    },
    "__schema1": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$"
    },
    "__schema2": {
      "type": "null"
    },
    "__schema3": {
      "type": "null"
    },
    "__schema4": {
      "type": "null"
    },
    "__schema5": {
      "type": "string"
    },
    "__schema6": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema6"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema6"
          }
        }
      ]
    },
    "__schema7": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/__schema5"
      },
      "additionalProperties": {
        "$ref": "#/$defs/__schema6"
      }
    },
    "__schema8": {
      "type": "array",
      "items": false,
      "maxItems": 0
    },
    "__schema9": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema5"
      }
    },
    "__schema10": {
      "type": "object",
      "properties": {
        "code": {
          "minLength": 1,
          "$ref": "#/$defs/__schema5"
        },
        "message": {
          "$ref": "#/$defs/__schema5"
        },
        "details": {
          "$ref": "#/$defs/__schema7"
        }
      },
      "required": [
        "code",
        "message",
        "details"
      ],
      "additionalProperties": false
    },
    "__schema11": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "artifact_id": {
            "$ref": "#/$defs/__schema1"
          },
          "uri": {
            "pattern": "^cad:\\/\\/artifacts\\/[a-zA-Z0-9_-]+\\/manifest$",
            "$ref": "#/$defs/__schema5"
          },
          "download": {
            "pattern": "^\\/api\\/artifacts\\/[a-zA-Z0-9_-]+$",
            "$ref": "#/$defs/__schema5"
          },
          "hash": {
            "$ref": "#/$defs/__schema12"
          },
          "mime": {
            "$ref": "#/$defs/__schema5"
          },
          "size": {
            "$ref": "#/$defs/__schema13"
          },
          "manifest": {
            "$ref": "#/$defs/__schema7"
          }
        },
        "required": [
          "artifact_id",
          "uri",
          "download",
          "hash",
          "mime",
          "size",
          "manifest"
        ],
        "additionalProperties": false
      }
    },
    "__schema12": {
      "pattern": "^[a-f0-9]{64}$",
      "$ref": "#/$defs/__schema5"
    },
    "__schema13": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "type": "object"
}
