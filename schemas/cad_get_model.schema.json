{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "model_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$"
    },
    "revision": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$"
    },
    "offset": {
      "default": 0,
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "limit": {
      "default": 32,
      "type": "integer",
      "minimum": 1,
      "maximum": 64
    }
  },
  "required": [
    "model_id",
    "offset",
    "limit"
  ],
  "additionalProperties": false
}
