{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "const": "inspect"
        },
        "model_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$"
        },
        "offset": {
          "default": 0,
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "limit": {
          "default": 8,
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        }
      },
      "required": [
        "mode",
        "model_id",
        "offset",
        "limit"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "const": "propose"
        },
        "model_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$"
        },
        "base_revision": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$"
        },
        "change": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "action": {
                  "type": "string",
                  "const": "grant"
                },
                "grant": {
                  "type": "object",
                  "properties": {
                    "recipient": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128,
                      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                    },
                    "role": {
                      "type": "string",
                      "enum": [
                        "reader",
                        "designer",
                        "reviewer",
                        "editor"
                      ]
                    },
                    "can_export": {
                      "type": "boolean"
                    },
                    "edit_scope": {
                      "anyOf": [
                        {
                          "type": "object",
                          "properties": {
                            "kind": {
                              "type": "string",
                              "const": "model"
                            }
                          },
                          "required": [
                            "kind"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "kind": {
                              "type": "string",
                              "const": "features"
                            },
                            "feature_ids": {
                              "minItems": 1,
                              "maxItems": 256,
                              "type": "array",
                              "items": {
                                "type": "string",
                                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$"
                              }
                            }
                          },
                          "required": [
                            "kind",
                            "feature_ids"
                          ],
                          "additionalProperties": false
                        }
                      ]
                    },
                    "budget": {
                      "type": "object",
                      "properties": {
                        "jobs": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 1000
                        },
                        "seconds_per_job": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 45
                        }
                      },
                      "required": [
                        "jobs",
                        "seconds_per_job"
                      ],
                      "additionalProperties": false
                    },
                    "expires_at": {
                      "type": "string",
                      "format": "date-time",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                    }
                  },
                  "required": [
                    "recipient",
                    "role",
                    "can_export",
                    "edit_scope",
                    "budget",
                    "expires_at"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "action",
                "grant"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "action": {
                  "type": "string",
                  "const": "revoke"
                },
                "recipient": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                }
              },
              "required": [
                "action",
                "recipient"
              ],
              "additionalProperties": false
            }
          ]
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 16,
          "maxLength": 128
        }
      },
      "required": [
        "mode",
        "model_id",
        "base_revision",
        "change",
        "idempotency_key"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "const": "request"
        },
        "model_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$"
        },
        "approval_request_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$"
        }
      },
      "required": [
        "mode",
        "model_id",
        "approval_request_id"
      ],
      "additionalProperties": false
    }
  ],
  "type": "object"
}
