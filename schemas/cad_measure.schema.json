{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "model_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$"
    },
    "revision": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$"
    },
    "feature_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$"
    },
    "metric": {
      "default": "all",
      "type": "string",
      "enum": [
        "all",
        "volume",
        "area",
        "bounds",
        "radius",
        "depth",
        "width",
        "remaining_wall",
        "distance",
        "angle",
        "curvature",
        "clearance"
      ]
    },
    "other_feature_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$"
    },
    "face_id": {
      "type": "string",
      "pattern": "^face_[a-f0-9]{32}$"
    },
    "other_face_id": {
      "type": "string",
      "pattern": "^face_[a-f0-9]{32}$"
    },
    "uv": {
      "type": "array",
      "prefixItems": [
        {
          "type": "string",
          "maxLength": 48,
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
        },
        {
          "type": "string",
          "maxLength": 48,
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "other_uv": {
      "type": "array",
      "prefixItems": [
        {
          "type": "string",
          "maxLength": 48,
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
        },
        {
          "type": "string",
          "maxLength": 48,
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "curve_parameter": {
      "type": "string",
      "maxLength": 48,
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
    },
    "other_curve_parameter": {
      "type": "string",
      "maxLength": 48,
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
    },
    "minimum_clearance": {
      "type": "object",
      "properties": {
        "value": {
          "type": "string",
          "maxLength": 48,
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
        },
        "unit": {
          "type": "string",
          "enum": [
            "1",
            "m",
            "mm",
            "um",
            "rad",
            "deg"
          ]
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "additionalProperties": false
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 16,
      "maxLength": 128
    }
  },
  "required": [
    "model_id",
    "metric"
  ],
  "additionalProperties": false
}
