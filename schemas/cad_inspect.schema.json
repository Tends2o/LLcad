{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "model_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$"
    },
    "revision": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$"
    },
    "feature_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$"
    },
    "selection_handle": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$"
    },
    "face_id": {
      "type": "string",
      "pattern": "^face_[a-f0-9]{32}$"
    },
    "rebind": {
      "default": false,
      "type": "boolean"
    },
    "face_offset": {
      "default": 0,
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "face_limit": {
      "default": 8,
      "type": "integer",
      "minimum": 1,
      "maximum": 16
    },
    "sections": {
      "maxItems": 6,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "faces",
          "constraints",
          "facts",
          "contracts",
          "quality",
          "adjacency"
        ]
      }
    },
    "anchor": {
      "type": "object",
      "properties": {
        "point": {
          "type": "array",
          "prefixItems": [
            {
              "type": "string",
              "maxLength": 48,
              "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
            },
            {
              "type": "string",
              "maxLength": 48,
              "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
            },
            {
              "type": "string",
              "maxLength": 48,
              "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
            }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        },
        "normal": {
          "type": "array",
          "prefixItems": [
            {
              "type": "string",
              "maxLength": 48,
              "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
            },
            {
              "type": "string",
              "maxLength": 48,
              "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
            },
            {
              "type": "string",
              "maxLength": 48,
              "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
            }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        },
        "barycentric": {
          "type": "array",
          "prefixItems": [
            {
              "type": "string",
              "maxLength": 48,
              "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
            },
            {
              "type": "string",
              "maxLength": 48,
              "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
            },
            {
              "type": "string",
              "maxLength": 48,
              "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
            }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        },
        "triangle_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        },
        "view_direction": {
          "type": "array",
          "prefixItems": [
            {
              "type": "string",
              "maxLength": 48,
              "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
            },
            {
              "type": "string",
              "maxLength": 48,
              "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
            },
            {
              "type": "string",
              "maxLength": 48,
              "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
            }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        }
      },
      "required": [
        "point"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "model_id",
    "rebind",
    "face_offset",
    "face_limit"
  ],
  "additionalProperties": false
}
