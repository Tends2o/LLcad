{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "model_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$"
    },
    "base_revision": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 16,
      "maxLength": 128
    },
    "target_registry_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "mode": {
      "default": "plan",
      "type": "string",
      "enum": [
        "plan",
        "candidate"
      ]
    }
  },
  "required": [
    "model_id",
    "base_revision",
    "idempotency_key",
    "target_registry_hash",
    "mode"
  ],
  "additionalProperties": false
}
