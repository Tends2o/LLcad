{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "params",
    "refs",
    "output",
    "required_validators",
    "engine"
  ],
  "properties": {
    "version": {
      "type": "integer"
    },
    "params": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "dimension"
        ],
        "properties": {
          "dimension": {
            "enum": [
              "length",
              "angle",
              "scalar"
            ]
          },
          "min": {
            "type": "number"
          },
          "max": {
            "type": "number"
          },
          "optional": {
            "type": "boolean"
          },
          "integer": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "refs": {
      "type": "array",
      "items": {
        "type": "integer"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "output": {
      "type": "string"
    },
    "required_validators": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "engine": {
      "type": "string"
    }
  }
}
